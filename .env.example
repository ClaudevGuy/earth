# Local-only browser fallback. Do not put a Helius API key here — it ships to the client.
VITE_RPC_URL=https://api.mainnet-beta.solana.com
# Server-only. Used by Netlify /api/rpc. Put your Helius URL+key in the Netlify dashboard, not in git.
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
# Optional. Enables Jupiter as an extra aggregator venue for SPL / Token-2022.
JUPITER_API_KEY=
# $EARTH mint. Leave empty until the token is live. Listing a custom standard burns $1,000 of $EARTH.
VITE_EARTH_MINT=
